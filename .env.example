# Copie para server/.env (local) ou configure no Vercel — NUNCA coloque estas chaves no frontend (src/).
# Pinguim — busca no Google Maps. Apify é a primeira opção (Google Maps Scraper; console.apify.com → Settings → API & Integrations).
APIFY_TOKEN=
# SerpApi é a segunda opção (250 buscas grátis/mês em serpapi.com).
SERPAPI_KEY=
# Opcional (reserva): Places API do Google. Sem nenhuma fonte de Maps, o Pinguim usa o OpenStreetMap.
GOOGLE_PLACES_API_KEY=
FIRECRAWL_API_KEY=
# Tigre — IA que escreve as mensagens e lê as respostas. Groq tem prioridade (console.groq.com → API Keys, começa com gsk_).
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
ANTHROPIC_API_KEY=
CLOUDINARY_URL=
# Leão — pasta online das fotos (Vercel Blob). No Vercel: Storage → Create → Blob (Public) → conectar ao projeto;
# o Vercel cria esta variável sozinho. Localmente, copie o valor de lá.
BLOB_READ_WRITE_TOKEN=
# Tigre — envio pela Z-API (tem prioridade). Client-Token só se ativou o token de segurança da conta.
ZAPI_INSTANCE_ID=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=
# Tigre — ou pela API oficial da Meta:
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
VERCEL_TOKEN=
# Tigre (opcionais): template aprovado pela Meta para o 1º contato, idioma do template e time do Vercel.
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=pt_BR
VERCEL_TEAM_ID=
