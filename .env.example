# Copie para server/.env (local) ou configure no Vercel — NUNCA coloque estas chaves no frontend (src/).
# Pinguim — busca no Google Maps. Apify é a primeira opção (Google Maps Scraper; console.apify.com → Settings → API & Integrations).
APIFY_TOKEN=
# SerpApi é a segunda opção (250 buscas grátis/mês em serpapi.com).
SERPAPI_KEY=
# Opcional (reserva): Places API do Google. Sem nenhuma fonte de Maps, o Pinguim usa o OpenStreetMap.
GOOGLE_PLACES_API_KEY=
FIRECRAWL_API_KEY=
# 🔎 Buscadores extras (o Pinguim confere "tem site?" com o próximo quando acaba o crédito de um).
# Ordem: Firecrawl → Tavily → Exa → Serper → Brave. Basta um. Todos têm plano grátis:
# Tavily: 1.000 buscas/mês, sem cartão — app.tavily.com (a chave começa com tvly-)
TAVILY_API_KEY=
# Exa: US$ 10/mês em créditos, sem cartão — dashboard.exa.ai
EXA_API_KEY=
# Serper (resultados do Google): 2.500 buscas uma vez só, sem cartão — serper.dev
SERPER_API_KEY=
# Brave: US$ 5/mês (~1.000 buscas), pede cartão — api-dashboard.search.brave.com
BRAVE_API_KEY=
# Tigre — IA que escreve as mensagens e lê as respostas. Groq tem prioridade (console.groq.com → API Keys, começa com gsk_).
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_VISION_MODEL=qwen/qwen3.8-27b   # o Castor lê as imagens de modelo que você faz no Gemini
# 🍌 Nano Banana (Gemini): o Castor desenha os 3 modelos — chave em https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# GEMINI_TEXT_MODEL=gemini-flash-latest   # o Gato monta o site igual à imagem escolhida (sem Gemini, usa a Groq)
ANTHROPIC_API_KEY=
CLOUDINARY_URL=
# Leão — pasta online das fotos (Vercel Blob). No Vercel: Storage → Create → Blob (Public) → conectar ao projeto;
# o Vercel cria esta variável sozinho. Localmente, copie o valor de lá.
BLOB_READ_WRITE_TOKEN=
# Tigre — envio pela Z-API (tem prioridade). Client-Token só se ativou o token de segurança da conta.
ZAPI_INSTANCE_ID=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=
# Tigre — ou pela API oficial da Meta:
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
VERCEL_TOKEN=
# Tigre (opcionais): template aprovado pela Meta para o 1º contato, idioma do template e time do Vercel.
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=pt_BR
VERCEL_TEAM_ID=
