{
  "name": "central-agentes",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:api": "node --watch server/index.js",
    "start": "node server/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "build:demo": "VITE_HASH_ROUTER=1 vite build --base ./ --outDir dist-demo"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@hono/node-server": "^2.1.5",
    "@vercel/blob": "^2.8.2",
    "framer-motion": "^11.11.0",
    "hono": "^4.13.13",
    "jszip": "^3.10.2",
    "lucide-react": "^0.460.0",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.6",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "vite": "^5.4.11"
  },
  "optionalDependencies": {
    "ffmpeg-static": "^5.2.0",
    "playwright-core": "^1.56.1"
  }
